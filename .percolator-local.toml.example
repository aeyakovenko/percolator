# Local Percolator Configuration
# Copy this file to .percolator-local.toml and update with your deployed program IDs
# This file should be git-ignored so each developer can have their own local setup

[localnet]
# Program IDs for your localnet deployment
# Generate keypairs first (see keys/README.md for instructions)
# Then get program IDs by running: solana-keygen pubkey keys/percolator_<program>-keypair.json
router_program_id = ""
slab_program_id = ""
amm_program_id = ""
oracle_program_id = ""

[devnet]
# Program IDs for devnet (optional)
router_program_id = ""
slab_program_id = ""
amm_program_id = ""
oracle_program_id = ""

[mainnet-beta]
# Program IDs for mainnet (optional)
router_program_id = ""
slab_program_id = ""
amm_program_id = ""
oracle_program_id = ""
